# Documentation example. The operator CLI writes validated, non-secret instance.json.
# Generate independent credentials with ratefreak.py init; never use example passwords.
# Public root HTTPS origin; bundled Caddy needs DNS/ports or explicit local CA trust.
RATEFREAK_PUBLIC_ORIGIN=https://ratefreak.example
# Runtime configuration is supplied by Compose; provider/OAuth overrides are optional.
# External PostgreSQL must use RATEFREAK_DB_SSLMODE=VerifyFull and deliberate credentials.
# Local PostgreSQL and every database/artwork backup copy: maximum 30-day retention.
# Journal: independently replicate append-preserving records outside ordinary backups.
