# Local PostgreSQL only. Copy to .env and replace this password before starting.
POSTGRES_DB=ratefreak
POSTGRES_USER=ratefreak
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=55432
# .NET does not load .env files automatically. Set ConnectionStrings:Default via
# user-secrets or ConnectionStrings__Default in the shell. See README.md.

# Optional TMDB settings for the .NET process (not consumed by Compose).
# Keep the API Read Access Token in user-secrets or the deployment secret store.
# Providers__Tmdb__Enabled=true
# Providers__Tmdb__Language=en-US
# Providers__Tmdb__TimeoutMilliseconds=4000
# Providers__Tmdb__AccessToken=  # Never commit a real token here.

# Optional MusicBrainz settings for the .NET process (not consumed by Compose).
# No API key required. Contact must be your chosen email or HTTPS contact URL;
# it is sent to MusicBrainz in the outbound User-Agent. Export these variables
# or use .NET user-secrets; the API does not automatically load .env.
# Providers__MusicBrainz__Enabled=false
# Providers__MusicBrainz__TimeoutMilliseconds=6000
# Providers__MusicBrainz__Contact=you@example.com

# Optional IGDB app settings for the .NET process (not consumed by Compose).
# Put real Twitch client credentials in user-secrets or the deployment secret store.
# Providers__Igdb__Enabled=false
# Providers__Igdb__TimeoutMilliseconds=6000
# Providers__Igdb__ClientId=
# Providers__Igdb__ClientSecret=

# Optional external sign-in for the .NET process (not consumed by Compose).
# Register separate OAuth apps and keep credentials in user-secrets/secret storage.
# Authentication__External__PublicOrigin=https://localhost:5081
# Authentication__External__Google__Enabled=false
# Authentication__External__Google__ClientId=
# Authentication__External__Google__ClientSecret=
# Authentication__External__GitHub__Enabled=false
# Authentication__External__GitHub__ClientId=
# Authentication__External__GitHub__ClientSecret=

# Fresh-install first administrator setup, for the .NET process only.
# Generate with: openssl rand -hex 32
# Set through user-secrets or the deployment secret store, not Next.js/NEXT_PUBLIC_.
# Required only while setup is pending; existing-account upgrades stay initialized.
# Installation__SetupSecret=
