    "-c",
    "for p in /etc/editrc /root/.editrc /var/lib/postgresql/.editrc /etc/krb5.conf /etc/gss/mech; do if test -e \"$p\"; then echo \"$p exists\"; else echo \"$p absent\"; fi; done"
